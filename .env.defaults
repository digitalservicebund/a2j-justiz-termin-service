# Local PostgreSQL (matches docker-compose.yml)
DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_USER=jts
DATABASE_PASSWORD=jts
DATABASE_NAME=a2j-justiz-termin-service

# Local SMTP mock (Mailpit, see docker-compose.yml); it has no STARTTLS and accepts any credentials
SMTP_HOST=localhost
SMTP_PORT=2525
SMTP_USER=dummy
SMTP_PASSWORD=dummy
SMTP_REQUIRE_TLS=false

# Local RabbitMQ (see docker-compose.yml); it has no TLS
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5673
RABBITMQ_VHOST=/
RABBITMQ_USER=jts
RABBITMQ_PASSWORD=jts
RABBITMQ_TLS=false

BASE_URL=http://localhost:3000

BETTER_AUTH_SECRET=local-development-only-dummy-better-auth-secret
