{
  "name": "a2j-justiz-termin-service",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "NODE_ENV=development node --env-file=.env.defaults --env-file-if-exists=.env.local --env-file-if-exists=.env --conditions development server.js",
    "start": "node --env-file-if-exists=.env.defaults server.js",
    "db:migrate": "node --env-file=.env.defaults --env-file-if-exists=.env.local --env-file-if-exists=.env app/database/migrate.ts",
    "user:create-admin": "node --env-file=.env.defaults --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/create-admin.ts",
    "domain:add": "node --env-file=.env.defaults --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/add-domain.ts",
    "psql": "docker compose exec postgres psql -U jts -d a2j-justiz-termin-service",
    "docker:reset": "docker compose down --volumes --remove-orphans && docker compose up -d",
    "typecheck": "react-router typegen && tsc",
    "test": "vitest run",
    "test:e2e": "sh e2e/run.sh",
    "test:all": "pnpm test && pnpm test:e2e",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint:check": "oxlint",
    "lint:fix": "oxlint --fix",
    "format:check": "oxfmt --check",
    "format:fix": "oxfmt",
    "knip": "knip && knip --production",
    "adr:toc": "adr generate toc > doc/adr/README.md && oxfmt doc/adr/README.md"
  },
  "dependencies": {
    "@kern-ux/native": "2.9.0",
    "@react-router/express": "8.5.2",
    "@react-router/node": "8.5.2",
    "amqplib": "2.4.1",
    "better-auth": "1.7.27",
    "compression": "1.8.2",
    "express": "5.3.0",
    "html-template-tag": "5.0.0",
    "isbot": "5.2.3",
    "kysely": "0.29.9",
    "nodemailer": "10.6.1",
    "pdfkit": "0.21.0",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.2",
    "svg-to-pdfkit": "0.1.8",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "@react-router/dev": "8.5.2",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "@types/nodemailer": "8.0.2",
    "@types/pdfkit": "0.17.7",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-istanbul": "5.1.1",
    "ical.js": "2.2.1",
    "jsdom": "31.0.1",
    "jsqr": "1.4.0",
    "knip": "6.48.0",
    "oxfmt": "0.80.0",
    "oxlint": "1.95.0",
    "pino-pretty": "13.2.0",
    "typescript": "7.0.2",
    "unpdf": "2.2.1",
    "vite": "8.3.8",
    "vite-plugin-devtools-json": "1.1.2",
    "vitest": "5.1.1",
    "xmllint-wasm": "5.3.0"
  },
  "engines": {
    "node": ">=26.12.1"
  },
  "packageManager": "pnpm@12.23.0"
}
