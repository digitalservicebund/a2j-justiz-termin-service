{
  "name": "a2j-justiz-termin-service",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "cross-env NODE_ENV=development node --env-file=.env.defaults --env-file-if-exists=.env.local --conditions development server.js",
    "start": "node --env-file-if-exists=.env.defaults server.js",
    "db:migrate": "node --env-file=.env.defaults --env-file-if-exists=.env.local app/database/migrate.ts",
    "user:create-admin": "node --env-file=.env.defaults --env-file-if-exists=.env.local scripts/create-admin.ts",
    "psql": "docker compose exec postgres psql -U jts -d a2j-justiz-termin-service",
    "docker:reset": "docker compose down --volumes --remove-orphans && docker compose up -d",
    "typecheck": "react-router typegen && tsc",
    "test": "vitest run",
    "test:e2e": "sh e2e/run.sh",
    "test:all": "pnpm test && pnpm test:e2e",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint:check": "oxlint",
    "lint:fix": "oxlint --fix",
    "format:check": "oxfmt --check",
    "format:fix": "oxfmt"
  },
  "dependencies": {
    "@kern-ux/native": "^2.8.2",
    "@react-router/express": "^8.4.0",
    "@react-router/node": "8.4.0",
    "better-auth": "^1.7.10",
    "compression": "^1.8.2",
    "cross-env": "^10.1.0",
    "express": "^5.3.0",
    "isbot": "^5.2.2",
    "kysely": "^0.29.6",
    "morgan": "^1.12.1",
    "nodemailer": "^10.1.1",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "8.4.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@react-router/dev": "8.4.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/express": "^5.0.6",
    "@types/express-serve-static-core": "^5.1.3",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-istanbul": "^5.0.4",
    "@vitest/coverage-v8": "3.2.4",
    "ical.js": "^2.2.1",
    "jsdom": "^25.0.1",
    "oxfmt": "0.73.0",
    "oxlint": "^1.87.0",
    "typescript": "^5.9.3",
    "vite": "8.1.1",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": ">=26.3.1"
  },
  "packageManager": "pnpm@11.9.0"
}
